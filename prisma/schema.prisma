generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
}

model Renter {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique
  password               String
  fullname               String
  phoneNumber            String    @map("phone_number")
  gender                 Gender
  profilePicture         String    @default("https://storage.googleapis.com/sigemes-storage/profile-pictures/default-picture.png") @map("profile_picture")
  emailVerified          Boolean   @default(false) @map("email_verified")
  otp                    String?   @db.VarChar(5)
  otpExpiry              DateTime? @map("otp_expiry")
  forgotPasswordVerified Boolean   @default(false) @map("forgot_password_verified")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("renters")
}

model Admin {
  id             Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(255)
  password       String   @db.VarChar(255)
  fullname       String   @db.VarChar(255)
  phoneNumber    String   @map("telephone_number") @db.VarChar(15)
  isSuperAdmin   Boolean  @default(false) @map("is_super_admin")
  profilePicture String   @default("https://storage.googleapis.com/sigemes-storage/profile-pictures/default-picture.png") @map("profile_picture")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("admins")
}
